{
  "manifest_version": 3,
  "name": "Now Playing Overlay",
  "version": "0.4.2",
  "description": "Send YouTube playback, artwork and captions to the Now Playing macOS overlay.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "minimum_chrome_version": "120",
  "incognito": "not_allowed",
  "permissions": [
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://music.youtube.com/*",
    "https://lrclib.net/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Refresh Now Playing connection",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://music.youtube.com/*"
      ],
      "js": [
        "parsers.js",
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://music.youtube.com/*"
      ],
      "js": [
        "adapters.js",
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
